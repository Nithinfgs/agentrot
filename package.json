{
  "name": "agentrot",
  "version": "0.1.0",
  "description": "Find the rot in your AGENTS.md / CLAUDE.md: verifies every path, script and tool your agent instructions mention against the actual repo.",
  "keywords": [
    "agents-md",
    "claude-md",
    "ai-agents",
    "coding-agents",
    "linter",
    "cli",
    "developer-tools",
    "context"
  ],
  "license": "MIT",
  "author": "Nithinfgs",
  "homepage": "https://github.com/Nithinfgs/agentrot#readme",
  "repository": { "type": "git", "url": "git+https://github.com/Nithinfgs/agentrot.git" },
  "bugs": { "url": "https://github.com/Nithinfgs/agentrot/issues" },
  "type": "module",
  "bin": { "agentrot": "dist/src/cli.js" },
  "files": ["dist/src", "README.md", "LICENSE"],
  "engines": { "node": ">=18" },
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "tsc && node scripts/test.mjs",
    "demo": "tsc && node scripts/render-demo.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
